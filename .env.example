# Copy this file to .env and adjust values for your machine.
# Never commit your real .env file.

# PostgreSQL
POSTGRES_USER=epoch
POSTGRES_PASSWORD=epoch_dev_password
POSTGRES_DB=epoch
POSTGRES_PORT=5432

# Backend
# Inside docker-compose the database host is the service name "db".
DATABASE_URL=postgresql+psycopg://epoch:epoch_dev_password@db:5432/epoch
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Auth (JWT + bcrypt)
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
